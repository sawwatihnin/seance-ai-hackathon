{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/portal",
      "destination": "/index.html"
    },
    {
      "source": "/community",
      "destination": "/index.html"
    },
    {
      "source": "/education",
      "destination": "/index.html"
    },
    {
      "source": "/business",
      "destination": "/index.html"
    }
  ],
  "trailingSlash": false
}
