{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/portal/:path*", "destination": "/index.html" },
    { "source": "/community/:path*", "destination": "/index.html" },
    { "source": "/education/:path*", "destination": "/index.html" },
    { "source": "/business/:path*", "destination": "/index.html" }
  ]
}
